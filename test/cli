awk '
  /^\[lock\]$/ { in_lock = 1; next }
  /^\[/ { in_lock = 0 }
  in_lock && /^text = "#ffffff"$/ { text = 1 }
  in_lock && /^placeholder = "#ffffff"$/ { placeholder = 1 }
  in_lock && /^border = "#ffffff"$/ { border = 1 }
