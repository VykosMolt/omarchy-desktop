# Copy to ~/omarchy-arch-port/runtime/env.sh and adjust only OMARCHY_PATH if
# the checkout is elsewhere. This file is sourced by the session launcher.
export OMARCHY_PATH="$HOME/omarchy-arch-port/port"
export OMARCHY_ARCH_SESSION=1
export OMARCHY_SESSION_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy-arch"
export OMARCHY_SESSION_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-arch"
export OMARCHY_SESSION_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}/omarchy-arch"
export OMARCHY_SESSION_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}/omarchy-arch"
export OMARCHY_CONFIG_HOME="$OMARCHY_SESSION_CONFIG_HOME/omarchy"
export OMARCHY_STATE_HOME="$OMARCHY_SESSION_STATE_HOME/omarchy"
export OMARCHY_CACHE_HOME="$OMARCHY_SESSION_CACHE_HOME/omarchy"
export OMARCHY_DATA_HOME="$OMARCHY_SESSION_DATA_HOME/omarchy"
export OMARCHY_SLEEP_LOCK_UNIT=omarchy-arch-sleep-lock.service
export KITTY_CONFIG_DIRECTORY="$OMARCHY_SESSION_CONFIG_HOME/kitty"
export PATH="$OMARCHY_PATH/bin:$PATH"
