[Unit]
Description=Omarchy Arch Fcitx5 input method
PartOf=omarchy-arch-session.target
After=wayland-session-waitenv.service
ConditionEnvironment=WAYLAND_DISPLAY
ConditionFileIsExecutable=/usr/bin/fcitx5
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
EnvironmentFile=%t/omarchy-arch-session.env
ExecCondition=/usr/bin/bash -c '! /usr/bin/flock -n %t/omarchy-arch-session.lock /usr/bin/true'
Type=simple
ExecStart=/usr/bin/fcitx5 --disable notificationitem

# on-failure, not always. fcitx5 exits 0 when another instance already owns the
# input method -- which is what happens when the host session started one -- and
# restarting cannot take it back, so `always` spun this unit tens of thousands
# of times in a single session. A crash still restarts, and the start limit
# stops even that from becoming a hot loop.
Restart=on-failure
RestartSec=2
