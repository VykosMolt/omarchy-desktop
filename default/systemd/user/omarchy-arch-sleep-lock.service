[Unit]
Description=Lock Omarchy Arch before suspend
PartOf=omarchy-arch-session.target
After=dbus.socket wayland-session-waitenv.service
Requires=dbus.socket
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
EnvironmentFile=%t/omarchy-arch-session.env
ExecCondition=/usr/bin/bash -c '! /usr/bin/flock -n %t/omarchy-arch-session.lock /usr/bin/true'
Type=simple
ExecStart=/usr/bin/env omarchy-system-sleep-monitor
Restart=always
RestartSec=2
