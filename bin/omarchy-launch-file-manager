#!/bin/bash

# omarchy:summary=Launch the file manager registered for directories
# omarchy:args=[path]

# This used to exec nautilus by name, which on a machine that has no nautilus is
# a key that does nothing at all. The desktop already records a file manager --
# it is whatever handles inode/directory -- so ask for that rather than naming
# one. uwsm-app takes a Desktop Entry ID directly, which keeps the app in the
# session scope; xdg-open is the fallback when nothing is registered.

target=${1:-$HOME}
desktop=$(xdg-mime query default inode/directory 2>/dev/null || true)

if [[ -n $desktop ]]; then
  exec setsid uwsm-app -- "$desktop" "$target"
fi

if omarchy-cmd-present xdg-open; then
  exec setsid uwsm-app -- xdg-open "$target"
fi

echo "omarchy-launch-file-manager: no file manager is registered for directories" >&2
exit 1
