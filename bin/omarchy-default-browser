#!/bin/bash

# omarchy:summary=Set the default browser for Omarchy and XDG handlers
# omarchy:args=[--list|chromium|chrome|brave|brave-origin|edge|firefox|zen]
# omarchy:examples=omarchy default browser --list | omarchy default browser firefox

# One table, read by both the picker and the setter, so a browser can never be
# offered in a list it cannot then be set from: id, command, desktop id, name,
# and the glyph the notification carries.
browsers() {
  cat <<'BROWSERS'
chromium	chromium	chromium.desktop	Chromium	
chrome	google-chrome-stable	google-chrome.desktop	Chrome	󰊯
brave	brave	brave-browser.desktop	Brave	󰖟
brave-origin	brave-origin	brave-origin.desktop	Brave Origin	󰖟
edge	microsoft-edge-stable	microsoft-edge.desktop	Edge	󰇩
firefox	firefox	firefox.desktop	Firefox	󰈹
zen	zen-browser	zen.desktop	Zen	󰖟
BROWSERS
}

# Only the browsers this machine can actually switch to.
if [[ ${1:-} == "--list" ]]; then
  while IFS=$'\t' read -r id command _desktop_id name _glyph; do
    if omarchy-cmd-present "$command"; then
      printf '%s\t%s\n' "$id" "$name"
    fi
  done < <(browsers)
  exit 0
fi

if (($# == 0)); then
  # Read the answer where xdg-settings writes it before paying for
  # xdg-settings. That is a shell script that probes several desktops and
  # validates what it finds, and it costs 27ms -- the single most expensive
  # thing in the menu's guard batch, which runs on every menu open. The value
  # it reports for a browser set through it is the http scheme handler in
  # mimeapps.list, which is a two-line read.
  #
  # xdg-settings stays as the fallback: it knows about GNOME and KDE's own
  # settings stores, which a bare mimeapps.list read does not.
  #
  # It also used to be called twice, because the unmatched arm below ran it
  # again -- and the unmatched arm is the common one, since a browser that
  # registers itself gets a generated id rather than its packaged one.
  current=""
  for _mimeapps in "${XDG_CONFIG_HOME:-$HOME/.config}/mimeapps.list" \
    "${XDG_DATA_HOME:-$HOME/.local/share}/applications/mimeapps.list"; do
    [[ -r $_mimeapps ]] || continue
    current=$(awk -F= '/^x-scheme-handler\/https?=/ { sub(/;.*/, "", $2); print $2; exit }' "$_mimeapps")
    [[ -n $current ]] && break
  done

  [[ -n $current ]] || current=$(env -u BROWSER xdg-settings get default-web-browser)

  case "$current" in
  chromium.desktop) echo "chromium" ;;
  google-chrome.desktop) echo "chrome" ;;
  brave-browser.desktop) echo "brave" ;;
  brave-origin.desktop) echo "brave-origin" ;;
  microsoft-edge.desktop) echo "edge" ;;
  firefox.desktop) echo "firefox" ;;
  zen.desktop) echo "zen" ;;
  # Zen installs itself as userapp-Zen-<id>.desktop, and any browser set through
  # xdg-settings rather than by its package can look like that. Match the family
  # from the generated name so the Defaults menu can show which one is current;
  # without this the row for a browser installed that way is never checked.
  userapp-Zen-*.desktop | userapp-zen-*.desktop) echo "zen" ;;
  userapp-*firefox*.desktop | userapp-*Firefox*.desktop) echo "firefox" ;;
  userapp-*hrom*.desktop) echo "chromium" ;;
  userapp-*rave*.desktop) echo "brave" ;;
  *) printf '%s\n' "$current" ;;
  esac
  exit 0
fi

command=""
while IFS=$'\t' read -r id candidate_command candidate_desktop_id candidate_name candidate_glyph; do
  if [[ $id == "$1" ]]; then
    command="$candidate_command"
    desktop_id="$candidate_desktop_id"
    name="$candidate_name"
    glyph="$candidate_glyph"
    break
  fi
done < <(browsers)

if [[ -z $command ]]; then
  echo "Usage: omarchy-default-browser <chromium|chrome|brave|brave-origin|edge|firefox|zen>"
  exit 1
fi

if omarchy-cmd-missing "$command"; then
  echo "$name is not installed." >&2
  exit 1
fi

env -u BROWSER xdg-settings set default-web-browser "$desktop_id" || exit 1

omarchy-notification-send -g $glyph "$name is now the default browser"
