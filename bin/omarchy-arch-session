#!/bin/bash

# omarchy:summary=Start the isolated Omarchy Arch session under uwsm
# omarchy:args=[--dry-run]
# omarchy:hidden=true

set -euo pipefail

ENV_FILE="$HOME/omarchy-arch-port/runtime/env.sh"

if [[ ! -r $ENV_FILE ]]; then
  echo "Omarchy Arch environment not found: $ENV_FILE" >&2
  exit 1
fi

source "$ENV_FILE"

SESSION_RUNTIME="${XDG_RUNTIME_DIR:-/run/user/$UID}"
export DBUS_SESSION_BUS_ADDRESS="unix:path=$SESSION_RUNTIME/bus"
SESSION_ENV_FILE="$SESSION_RUNTIME/omarchy-arch-session.env"
SESSION_LOCK_FILE="$SESSION_RUNTIME/omarchy-arch-session.lock"
export KITTY_CONFIG_DIRECTORY="$OMARCHY_SESSION_CONFIG_HOME/kitty"

HYPR_CONFIG="$OMARCHY_SESSION_CONFIG_HOME/hypr/hyprland.lua"
START_HYPRLAND_BIN=$(type -P start-hyprland || true)

write_systemd_env() {
  local name value

  for name in \
    OMARCHY_PATH \
    OMARCHY_ARCH_SESSION \
    OMARCHY_SESSION_CONFIG_HOME \
    OMARCHY_SESSION_STATE_HOME \
    OMARCHY_SESSION_CACHE_HOME \
    OMARCHY_SESSION_DATA_HOME \
    OMARCHY_CONFIG_HOME \
    OMARCHY_STATE_HOME \
    OMARCHY_CACHE_HOME \
    OMARCHY_DATA_HOME \
    OMARCHY_SLEEP_LOCK_UNIT \
    KITTY_CONFIG_DIRECTORY \
    PATH
  do
    value=${!name}
    value=${value//\\/\\\\}
    value=${value//\"/\\\"}
    printf '%s="%s"\n' "$name" "$value"
  done
}

if [[ ! -f $HYPR_CONFIG ]]; then
  echo "Omarchy Arch Hyprland config not found: $HYPR_CONFIG" >&2
  exit 1
fi

if [[ ! -x $START_HYPRLAND_BIN ]]; then
  echo "start-hyprland is not available on PATH" >&2
  exit 1
fi

uwsm_args=(
  start
  -g -1
  -e
  -D Hyprland
  -N "Omarchy Arch"
  -C "Omarchy Quattro port for Arch Linux"
)

dry_run=0
if [[ ${1:-} == "--dry-run" ]]; then
  dry_run=1
  uwsm_args+=(-n)
  shift
fi

ensure_no_graphical_desktop() {
  local desktop_status=0
  pgrep -u "$UID" -x 'kwin_wayland|plasmashell|Hyprland|sway|gnome-shell' >/dev/null || desktop_status=$?
  if (( desktop_status == 0 )); then
    echo "A graphical desktop is already running. Log out before starting Omarchy Arch." >&2
    return 1
  elif (( desktop_status != 1 )); then
    echo "Could not verify whether a graphical desktop is running; refusing to change session state." >&2
    return 1
  fi
}

if (( ! dry_run )); then
  # This is an alternative login session. Never tear down or borrow the user
  # manager of a desktop that is still running for this account.
  ensure_no_graphical_desktop

  # Take ownership before changing state or shared runtime files. A second
  # launcher must leave the running session's environment and units untouched.
  exec 9> "$SESSION_LOCK_FILE"
  if ! /usr/bin/flock -n 9; then
    echo "An Omarchy Arch session is already running." >&2
    exit 1
  fi

  # A crashed standalone compositor may leave its session target holding the
  # shared target active. Recover only after proving no desktop is running;
  # UWSM still performs its own final exclusivity check before startup.
  graphical_state=$(systemctl --user show graphical-session.target --property=ActiveState --value)
  case $graphical_state in
    active|activating)
      ensure_no_graphical_desktop
      systemctl --user stop graphical-session.target
      ;;
    inactive|failed|deactivating) ;;
    *)
      echo "Unexpected graphical session state: $graphical_state" >&2
      exit 1
      ;;
  esac

  wm_instance=$(systemd-escape "${START_HYPRLAND_BIN##*/}")
  wm_dropin="$SESSION_RUNTIME/systemd/user/wayland-wm@${wm_instance}.service.d/20-omarchy-arch-session.conf"
  session_pid=""
  terminating=0
  cleanup() {
    rm -f -- "$SESSION_ENV_FILE" "$wm_dropin"
    systemctl --user daemon-reload >/dev/null 2>&1 || true
  }
  child_running() {
    local pid
    while IFS= read -r pid; do
      [[ $pid == "$session_pid" ]] && return 0
    done < <(jobs -pr)
    return 1
  }
  stop() {
    terminating=1
    child_running && kill -TERM "$session_pid" 2>/dev/null || true
  }
  trap cleanup EXIT
  trap stop HUP INT TERM

  mkdir -p -- "$OMARCHY_CONFIG_HOME" "$OMARCHY_STATE_HOME" \
    "$OMARCHY_CACHE_HOME" "$OMARCHY_DATA_HOME"

  # Recover from a stale "internal display disabled" state before Hyprland
  # starts. The probe uses sysfs only and changes Omarchy-Arch-owned state.
  omarchy-hw-recover-internal-monitor

  units=(
    omarchy-arch-session.target
    omarchy-arch-shell.service
    omarchy-arch-sleep-lock.service
    omarchy-arch-bt-agent.service
    omarchy-arch-monitor-watch.service
    omarchy-arch-udiskie.service
  )

  for unit in "${units[@]}"; do
    systemctl --user link --runtime --force \
      "$OMARCHY_PATH/default/systemd/user/$unit" >/dev/null
  done

  # Give only Omarchy-owned services the session environment. Do not import
  # it into the persistent systemd user manager.
  (
    umask 077
    env_tmp=$(mktemp "$SESSION_ENV_FILE.XXXXXX")
    trap 'rm -f -- "$env_tmp"' EXIT
    write_systemd_env > "$env_tmp"
    mv -f -- "$env_tmp" "$SESSION_ENV_FILE"
  )

  # Belt and braces for the session's own services. Hyprland starts them from
  # default/hypr/autostart.lua, which means the whole desktop -- bar, menu,
  # notifications -- appears only if that config loaded. It once did not, and
  # a login produced a bare compositor with no way to tell why. Ask uwsm's
  # compositor unit for the target as well, so the services follow the
  # compositor rather than a line inside its config. Wants= is deliberate:
  # a target that fails must not take the compositor down with it, and
  # starting an already-started target is a no-op, so the two paths cannot
  # collide.
  mkdir -p "$(dirname "$wm_dropin")"
  cat > "$wm_dropin" <<'WM_EOF'
[Unit]
Wants=omarchy-arch-session.target
WM_EOF

  systemctl --user daemon-reload
fi

# start-hyprland runs the compositor under its watchdog, and everything after
# `--` is handed to Hyprland. Launching hyprland.desktop loses --config, because
# that entry passes no arguments, and Hyprland then falls back to
# ~/.config/hypr/hyprland.lua -- the normal session's config, not this one. Going
# straight to the Hyprland binary keeps the config but skips the watchdog, and
# Hyprland says so on screen at every login. Naming start-hyprland and passing
# the config after `--` is what does both. Giving uwsm a path also puts it in
# hardcode mode, so the generated unit carries this exact command line.
if (( dry_run )); then
  exec uwsm "${uwsm_args[@]}" -- \
    "$START_HYPRLAND_BIN" -- \
    --config "$HYPR_CONFIG" \
    "$@"
fi

# Keep the lock in this supervisor, even when uwsm closes inherited file
# descriptors. Forward logout signals and wait for uwsm to finish teardown
# before removing the session environment and releasing ownership.
(( terminating )) && exit 143
uwsm "${uwsm_args[@]}" -- \
  "$START_HYPRLAND_BIN" -- \
  --config "$HYPR_CONFIG" \
  "$@" 9>&- &
session_pid=$!
(( terminating )) && stop
status=0
while true; do
  wait "$session_pid" && status=0 || status=$?
  child_running || break
done
exit "$status"
