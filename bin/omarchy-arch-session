#!/bin/bash
set -euo pipefail

ENV_FILE="$HOME/omarchy-arch-port/runtime/env.sh"

if [[ ! -r $ENV_FILE ]]; then
    echo "Omarchy Arch environment not found: $ENV_FILE" >&2
    exit 1
fi

source "$ENV_FILE"

SESSION_RUNTIME="${XDG_RUNTIME_DIR:-/run/user/$UID}"
SESSION_ENV_FILE="$SESSION_RUNTIME/omarchy-arch-session.env"
SESSION_LOCK_FILE="$SESSION_RUNTIME/omarchy-arch-session.lock"

HYPR_CONFIG="$OMARCHY_SESSION_CONFIG_HOME/hypr/hyprland.lua"
HYPRLAND_BIN=$(command -v Hyprland || echo /usr/bin/Hyprland)

write_systemd_env() {
    local name value

    for name in \
        OMARCHY_PATH \
        OMARCHY_ARCH_SESSION \
        OMARCHY_SESSION_CONFIG_HOME \
        OMARCHY_SESSION_STATE_HOME \
        OMARCHY_SESSION_CACHE_HOME \
        OMARCHY_SESSION_DATA_HOME \
        OMARCHY_CONFIG_HOME \
        OMARCHY_STATE_HOME \
        OMARCHY_CACHE_HOME \
        OMARCHY_DATA_HOME \
        OMARCHY_CRASH_WATCH_UNIT \
        OMARCHY_FCITX5_UNIT \
        OMARCHY_SLEEP_LOCK_UNIT \
        PATH
    do
        value=${!name}
        value=${value//\\/\\\\}
        value=${value//\"/\\\"}
        printf '%s="%s"\n' "$name" "$value"
    done
}

if [[ ! -f $HYPR_CONFIG ]]; then
    echo "Omarchy Arch Hyprland config not found: $HYPR_CONFIG" >&2
    exit 1
fi

uwsm_args=(
    start
    -g -1
    -e
    -D Hyprland
    -N "Omarchy Arch"
    -C "Omarchy Quattro port for Arch Linux"
)

dry_run=0
if [[ ${1:-} == "--dry-run" ]]; then
    dry_run=1
    uwsm_args+=(-n)
    shift
fi

if (( ! dry_run )); then
    # Recover from a stale "internal display disabled" state before Hyprland
    # starts. The probe uses sysfs only and changes Omarchy-Arch-owned state.
    omarchy-hw-recover-internal-monitor

    units=(
        omarchy-arch-session.target
        omarchy-arch-shell.service
        omarchy-arch-sleep-lock.service
        omarchy-arch-crash-watch.service
        omarchy-arch-fcitx5.service
        omarchy-arch-bt-agent.service
        omarchy-arch-monitor-watch.service
        omarchy-arch-udiskie.service
    )

    for unit in "${units[@]}"; do
        systemctl --user link --runtime --force \
            "$OMARCHY_PATH/default/systemd/user/$unit" >/dev/null
    done

    # Give only Omarchy-owned services the session environment. Do not import
    # it into the persistent systemd user manager.
    umask 077
    write_systemd_env > "$SESSION_ENV_FILE"

    # DMS is normally enabled for every Hyprland session on this account.
    # Add a runtime-only guard: DMS may start unless this lock is currently
    # held by the Omarchy Arch session launcher.
    dms_dropin="$SESSION_RUNTIME/systemd/user/dms.service.d/20-omarchy-arch-session.conf"
    mkdir -p "$(dirname "$dms_dropin")"
    cat > "$dms_dropin" <<'DMS_EOF'
[Service]
ExecCondition=/usr/bin/flock -n %t/omarchy-arch-session.lock /usr/bin/true
DMS_EOF

    systemctl --user daemon-reload
fi

# Launch the compositor binary directly rather than through hyprland.desktop.
# That entry runs /usr/bin/start-hyprland, which execs `Hyprland --watchdog-fd N`
# and forwards nothing else, so --config was silently dropped and Hyprland fell
# back to ~/.config/hypr/hyprland.lua -- the normal session's config, not this
# one. Giving uwsm a path also puts it in hardcode mode, so the generated unit
# carries this exact command line.
if (( dry_run )); then
    exec uwsm "${uwsm_args[@]}" -- \
        "$HYPRLAND_BIN" \
        --config "$HYPR_CONFIG" \
        "$@"
fi

# Hold this advisory lock for the complete lifetime of the Omarchy session.
# A stale lock file is harmless: flock state disappears when this process dies.
exec /usr/bin/flock -n "$SESSION_LOCK_FILE" \
    uwsm "${uwsm_args[@]}" -- \
        "$HYPRLAND_BIN" \
        --config "$HYPR_CONFIG" \
        "$@"
