#!/bin/bash

# omarchy:summary=Run a named hook from $OMARCHY_CONFIG_HOME/hooks/<name> and $OMARCHY_CONFIG_HOME/hooks/<name>.d/.
# omarchy:args=[name] [args...]

source "${OMARCHY_PATH:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)}/lib/omarchy-paths.sh"

set -e

if (( $# < 1 )); then
  echo "Usage: omarchy-hook [name] [args...]"
  exit 1
fi

omarchy_require_flat_name "$1" "hook name" || exit 1

HOOK=$1
HOOK_PATH="$OMARCHY_CONFIG_HOME/hooks/$1"
HOOK_DIR="$HOOK_PATH.d"
shift

if [[ -f $HOOK_PATH ]]; then
  bash "$HOOK_PATH" "$@" || echo "Hook failed: $HOOK_PATH"
fi

if [[ -d $HOOK_DIR ]]; then
  for hook in "$HOOK_DIR"/*; do
    [[ -f $hook ]] || continue
    [[ $hook == *.sample ]] && continue
    bash "$hook" "$@" || echo "Hook failed: $hook"
  done
fi
