#!/bin/bash

# omarchy:summary=Launch the browser chosen for Omarchy
# omarchy:args=[url]

omarchy_root="${OMARCHY_PATH:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)}"
default_browser=$("$omarchy_root/bin/omarchy-default-browser" --desktop) || exit 1
if [[ -z $default_browser ]]; then
  echo "No Omarchy browser is selected. Choose one in the Defaults menu." >&2
  exit 1
fi
browser_exec=$(sed -n 's/^Exec=\([^ ]*\).*/\1/p' {~/.local,~/.nix-profile,/usr}/share/applications/$default_browser 2>/dev/null | head -1)

if [[ -z $browser_exec ]]; then
  echo "Cannot resolve the Omarchy browser: $default_browser" >&2
  exit 1
fi

if "$browser_exec" --help 2>/dev/null | grep -q MOZ_LOG; then
  private_flag="--private-window"
elif [[ $browser_exec =~ edge ]]; then
  private_flag="--inprivate"
else
  private_flag="--incognito"
fi

systemd-run --user --quiet --collect --unit="omarchy-browser-$(date +%s%N)" \
  --property=StandardOutput=null --property=StandardError=null \
  uwsm-app -- "$browser_exec" "${@/--private/$private_flag}"

url=""
for argument in "$@"; do
  if [[ $argument != "--private" ]]; then
    url=$argument
    break
  fi
done

if [[ -n $url && -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]]; then
  omarchy-hyprland-focus-app "^$(basename "$browser_exec" -stable).*$" || true
fi
