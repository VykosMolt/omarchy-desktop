#!/bin/bash

# omarchy:summary=Launch a command in a floating terminal that waits for a keypress
# omarchy:args=<command>

cmd="$*"
presentation_script="$cmd; if (( \$? != 130 )); then omarchy-show-done; fi"

exec setsid uwsm-app -- xdg-terminal-exec --app-id=org.omarchy.terminal --title=Omarchy -e bash -c "$presentation_script"
