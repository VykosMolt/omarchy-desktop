#!/bin/bash

# omarchy:summary=Print active network status for the shell
# omarchy:group=network
# omarchy:args=[--verbose|--type]

source "${OMARCHY_PATH:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)}/lib/omarchy-network.sh"

verbose=false
type_only=false

case "${1:-}" in
  "")
    ;;
  --verbose)
    verbose=true
    ;;
  --type)
    type_only=true
    ;;
  *)
    echo "Usage: omarchy-network-status [--verbose|--type]" >&2
    exit 2
    ;;
esac

# Just the first field, for callers that only want to know whether this is wifi.
# The full line costs two nmcli calls and an iw call to fill in SSID, signal and
# frequency -- 34ms, and the menu's guard batch was paying all of it to read a
# prefix. The route lookup and a sysfs directory answer that in about nothing.
if [[ $type_only == true ]]; then
  device=$(omarchy_link_device)

  if [[ -z $device ]]; then
    echo disconnected
  elif [[ -d $OMARCHY_NET_SYSFS/$device/wireless ]]; then
    echo wifi
  elif omarchy_link_is_tunnel "$device"; then
    echo vpn
  else
    echo ethernet
  fi
  exit 0
fi

print_status() {
  local device nm state ssid signal freq

  device=$(omarchy_link_device)

  if [[ -z $device ]]; then
    printf 'disconnected\t\t\t\n'
    return
  fi

  if [[ ! -d $OMARCHY_NET_SYSFS/$device/wireless ]]; then
    if omarchy_link_is_tunnel "$device"; then
      printf 'vpn\t%s\t\t\n' "$device"
    else
      printf 'ethernet\t%s\t\t\n' "$device"
    fi
    return
  fi

  nm=$(LC_ALL=C nmcli -e no -t -f GENERAL.STATE,GENERAL.CONNECTION dev show "$device" 2>/dev/null)
  state=$(awk -F: '$1 == "GENERAL.STATE" { print $2; exit }' <<<"$nm")
  ssid=$(awk '/^GENERAL.CONNECTION:/ { sub(/^[^:]*:/, ""); print; exit }' <<<"$nm")
  signal=$(nmcli -t -f IN-USE,SIGNAL dev wifi list ifname "$device" --rescan no 2>/dev/null | awk -F: '$1 == "*" { print $2; exit }')
  freq=$(iw dev "$device" link 2>/dev/null | awk '/freq:/ { print $2; exit }')

  if [[ $state != 100* ]]; then
    printf 'disconnected\t\t\t\n'
    return
  fi

  printf 'wifi\t%s\t%s\t%s\n' "${ssid:-$device}" "$signal" "$freq"
}

ping_latency_ms() {
  local host=$1

  LC_ALL=C ping -n -c 1 -W 1 "$host" 2>/dev/null | awk -F'time[=<]' '/time[=<]/ { split($2, parts, " "); print parts[1]; exit }'
}

print_ping_samples() {
  local gateway=$1
  local tmpdir router_file internet_file
  local router_pid="" internet_pid=""

  omarchy-cmd-present ping || return
  tmpdir=$(mktemp -d) || return
  router_file="$tmpdir/router"
  internet_file="$tmpdir/internet"

  if [[ -n $gateway ]]; then
    ping_latency_ms "$gateway" >"$router_file" &
    router_pid=$!
  fi

  ping_latency_ms "$OMARCHY_INTERNET_PROBE" >"$internet_file" &
  internet_pid=$!

  if [[ -n $router_pid ]]; then
    wait "$router_pid"
    printf 'router_ping_ms\t%s\n' "$(<"$router_file")"
  fi

  wait "$internet_pid"
  printf 'internet_ping_ms\t%s\n' "$(<"$internet_file")"
  rm -rf "$tmpdir"
}

print_verbose() {
  local iface gw src prefix link

  iface=$(omarchy_link_device)
  [[ -z $iface ]] && return

  # From the link, not the route: while a VPN is up the route belongs to the
  # tunnel, whose /32 and absent gateway describe nothing. One jq for both, not
  # two -- this runs every 1.5s while the panel is open.
  IFS=$'\t' read -r src prefix < <(
    ip -j addr show "$iface" 2>/dev/null |
      jq -r 'first(.[0].addr_info[]? | select(.family == "inet")) | [(.local // ""), (.prefixlen // "")] | @tsv')

  gw=$(ip route show default dev "$iface" 2>/dev/null |
    awk '{ for (i = 1; i <= NF; i++) if ($i == "via") { print $(i + 1); exit } }')

  printf 'iface\t%s\n' "$iface"
  printf 'ip\t%s\n' "$src"
  printf 'prefix\t%s\n' "$prefix"
  printf 'gateway\t%s\n' "$gw"

  if [[ -r $OMARCHY_NET_SYSFS/$iface/statistics/rx_bytes ]]; then
    printf 'rx_bytes\t%s\n' "$(cat "$OMARCHY_NET_SYSFS/$iface/statistics/rx_bytes")"
  fi
  if [[ -r $OMARCHY_NET_SYSFS/$iface/statistics/tx_bytes ]]; then
    printf 'tx_bytes\t%s\n' "$(cat "$OMARCHY_NET_SYSFS/$iface/statistics/tx_bytes")"
  fi

  if [[ -d $OMARCHY_NET_SYSFS/$iface/wireless ]]; then
    printf 'type\twifi\n'

    if omarchy-cmd-present iw; then
      link=$(iw dev "$iface" link 2>/dev/null)

      if [[ -n $link ]]; then
        # One pass over the link report rather than four, for the same reason.
        awk '
          /SSID:/ && !ssid { line = $0; sub(/.*SSID: /, "", line); ssid = line }
          /signal:/ && !sig { sig = $2 }
          /freq:/ && !freq { freq = $2 }
          /tx bitrate:/ && !rate { rate = $3 " " $4 }
          END {
            printf "ssid\t%s\nsignal_dbm\t%s\nfreq\t%s\nbitrate\t%s\n", ssid, sig, freq, rate
          }
        ' <<<"$link"
      fi
    fi
  elif omarchy_link_is_tunnel "$iface"; then
    printf 'type\tvpn\n'
  else
    printf 'type\tethernet\n'
    [[ -r $OMARCHY_NET_SYSFS/$iface/speed ]] && printf 'speed\t%s\n' "$(cat "$OMARCHY_NET_SYSFS/$iface/speed")"
    [[ -r $OMARCHY_NET_SYSFS/$iface/duplex ]] && printf 'duplex\t%s\n' "$(cat "$OMARCHY_NET_SYSFS/$iface/duplex")"
  fi

  print_ping_samples "$gw"
}

if [[ $verbose == "true" ]]; then
  print_verbose
else
  print_status
fi
