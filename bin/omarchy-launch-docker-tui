#!/bin/bash

# omarchy:summary=Open the Docker TUI (lazydocker) with access to the Docker daemon
# omarchy:hidden=true

# lazydocker needs the Docker socket. Docker group membership is
# root-equivalent (a container can bind-mount / and rewrite the host as root),
# so this desktop never grants it; whether the socket is reachable is the
# host's business. Run lazydocker directly when the socket is already usable,
# and otherwise gate it behind a polkit prompt. pkexec sanitizes the
# environment, so carry TERM through for the TUI to render and run lazydocker
# from root's PATH.
# A socket we can write is a daemon we can drive without elevating; a missing
# one counts as needing sudo, since reaching it means starting it as root.
if [[ -w ${OMARCHY_DOCKER_SOCKET:-/var/run/docker.sock} ]]; then
  exec lazydocker
else
  exec pkexec /usr/bin/env TERM="${TERM:-xterm-256color}" lazydocker
fi
