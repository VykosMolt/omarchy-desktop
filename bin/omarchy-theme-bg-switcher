#!/bin/bash

# omarchy:summary=Open the Omarchy background switcher
# omarchy:group=theme
# omarchy:name=bg-switcher
# omarchy:aliases=omarchy background

source "${OMARCHY_PATH:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)}/lib/omarchy-paths.sh"
source "${OMARCHY_PATH:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)}/lib/omarchy-backgrounds.sh"

current_background=$(readlink -f "$OMARCHY_STATE_HOME/current/background" 2>/dev/null)

mapfile -t image_dirs < <(omarchy_background_dirs)

omarchy-menu-images \
  --selected "$current_background" \
  "${image_dirs[@]}"
