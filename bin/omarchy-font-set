#!/bin/bash

# omarchy:summary=Set the font used by the Omarchy shell and its terminals
# omarchy:args=<font-name>
# omarchy:examples=omarchy font list | omarchy font set "CaskaydiaMono Nerd Font"

usage() {
  echo "Usage: omarchy-font-set <font-name>"
}

font_name="${1:-}"

case "$font_name" in
  -h|--help)
    usage
    exit 0
    ;;
  "")
    usage >&2
    exit 1
    ;;
esac

if [[ $font_name == *[[:cntrl:]]* ]] || ! fc-list -f '%{family}\n' |
  FONT_NAME="$font_name" awk -F, 'BEGIN { want = tolower(ENVIRON["FONT_NAME"]) }
    { for (i = 1; i <= NF; i++) if (tolower($i) == want) found = 1 }
    END { exit !found }'; then
  echo "Font '$font_name' not found." >&2
  exit 1
fi

source "${OMARCHY_PATH:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)}/lib/omarchy-paths.sh"
source "${OMARCHY_PATH:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)}/lib/omarchy-ini.sh"

# Validate both destinations before changing either preference.
kitty=$(omarchy_kitty_config) || exit 1
omarchy_private_path "$OMARCHY_CONFIG_HOME" "$OMARCHY_CONFIG_HOME/appearance.ini" >/dev/null || exit 1

if [[ -f $kitty ]]; then
  python3 - "$font_name" "$kitty" <<'PYTHON'
import os
import sys
import tempfile
from pathlib import Path
family, filename = sys.argv[1:]
path = Path(filename)
lines = path.read_text().splitlines()
updated = []
found = False
for line in lines:
    if line.split(maxsplit=1)[:1] == ["font_family"]:
        if not found:
            updated.append("font_family " + family)
            found = True
    else:
        updated.append(line)
if not found:
    updated.append("font_family " + family)
fd, temporary = tempfile.mkstemp(prefix=".font-", dir=path.parent)
try:
    os.fchmod(fd, path.stat().st_mode & 0o777)
    with os.fdopen(fd, "w") as output:
        output.write("\n".join(updated) + "\n")
    os.replace(temporary, path)
finally:
    if os.path.exists(temporary):
        os.unlink(temporary)
PYTHON
  (( $? == 0 )) || exit 1
fi

omarchy_preference_set Font Family "$font_name" || exit 1
omarchy-restart-terminal
omarchy-hook font-set "$font_name"
