#!/bin/bash

# omarchy:summary=Check or mark completed Omarchy setup tasks
# omarchy:args=<check|mark|ensure> <name>
# omarchy:hidden=true

source "${OMARCHY_PATH:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)}/lib/omarchy-paths.sh"

set -e

if (( $# != 2 )); then
  echo "Usage: omarchy-done <check|mark|ensure> <name>" >&2
  exit 1
fi

action=$1
name=$2
done_dir="$OMARCHY_STATE_HOME/done"
marker="$done_dir/$name"

omarchy_require_flat_name "$name" "done marker name" || exit 1

case "$action" in
  check)
    [[ -f $marker ]]
    ;;
  mark)
    mkdir -p "$done_dir"
    touch "$marker"
    ;;
  ensure)
    mkdir -p "$done_dir"
    (set -o noclobber; : >"$marker") 2>/dev/null
    ;;
  *)
    echo "Usage: omarchy-done <check|mark|ensure> <name>" >&2
    exit 1
    ;;
esac
