#!/bin/bash

# omarchy:summary=Adjust output volume and show the Omarchy OSD
# omarchy:args=<raise|lower|mute-toggle|+N|-N>
# omarchy:examples=omarchy audio output volume raise | omarchy audio output volume lower | omarchy audio output volume mute-toggle | omarchy audio output volume +1

source "${OMARCHY_PATH:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)}/lib/omarchy-paths.sh"
runtime_dir=$(omarchy_runtime_dir) || exit 1

action="${1:-}"

if [[ -z $action ]]; then
  echo "Usage: omarchy-audio-output-volume <raise|lower|mute-toggle|+N|-N>"
  exit 1
fi

# Preserve each key event's read/modify/write update and debounce atomically.
exec {volume_lock_fd}>"$runtime_dir/omarchy-audio-output-volume.lock"
flock -w 2 "$volume_lock_fd" || exit 1

# Resolve through any DSP sink to the physical one, so the keys always move real
# loudness and the processing always sees full-scale input. Shared with the audio
# panel and the output switcher.
sink="$(omarchy-audio-output-sink)"
if [[ -z $sink ]]; then
  echo "Could not resolve an audio sink to control." >&2
  exit 1
fi

# pactl reports the same percentage scale wpctl does (both are the raw volume
# over PA_VOLUME_NORM), so the OSD reads identically either way.
volume_percent() {
  pactl get-sink-volume "$sink" 2>/dev/null |
    awk 'NR == 1 {
      for (i = 1; i <= NF; i++)
        if ($i ~ /%$/) {sub("%", "", $i); print $i; exit}
    }'
}

volume_muted() {
  [[ $(pactl get-sink-mute "$sink" 2>/dev/null) == *yes ]]
}

# Plasma's "Raise maximum volume" lifts every control at once, so the keys
# share the audio panel's switch rather than stopping at 100% while its slider
# keeps going. The switch is the panel's `raiseMaximumVolume` entry in
# shell.json, on unless it has been turned off, exactly as the panel reads it.
maximum_percent() {
  local config="$OMARCHY_CONFIG_HOME/shell.json"
  local raised=""

  if [[ -s $config ]]; then
    raised=$(jq -r '
      ([.bar.layout // {} | .[]? | .[]?] + (.plugins // []))
      | map(select(type == "object" and .id == "omarchy.audio"))
      | first // {}
      | .raiseMaximumVolume
      | if . == null then true else . end
    ' "$config" 2>/dev/null)
  fi

  if [[ $raised == "false" ]]; then
    echo 100
  else
    echo 200
  fi
}

case "$action" in
  raise) action="+5" ;;
  lower) action="-5" ;;
esac

if [[ $action == "mute-toggle" ]]; then
  debounce_file="$runtime_dir/omarchy-audio-output-volume-mute-toggle.last"
  now=$(date +%s%3N)
  last=0
  [[ -r $debounce_file ]] && read -r last <"$debounce_file" || true
  [[ $last =~ ^[0-9]{1,16}$ ]] || last=0
  last=$((10#$last))
  if ((now >= last && now - last < 250)); then
    exit 0
  fi
  printf '%s\n' "$now" >"$debounce_file"

  pactl set-sink-mute "$sink" toggle || exit 1
elif [[ $action =~ ^([+-])([0-9]+)$ ]]; then
  direction="${BASH_REMATCH[1]}"
  step="${BASH_REMATCH[2]}"
  if (( ${#step} > 9 )); then
    step=2147483647
  else
    step=$((10#$step))
  fi

  current="$(volume_percent)"
  if [[ ! $current =~ ^[0-9]{1,9}$ ]]; then
    echo "Could not read volume for $sink." >&2
    exit 1
  fi
  current=$((10#$current))

  maximum=$(maximum_percent)
  if [[ $direction == "+" ]]; then
    next=$((current + step))
    ((next <= maximum)) || next=$maximum
  else
    next=$((current - step))
    ((next >= 0)) || next=0
  fi

  pactl set-sink-mute "$sink" 0 || exit 1
  pactl set-sink-volume "$sink" "${next}%" || exit 1
else
  echo "Unknown volume action: $action"
  exit 1
fi

percent=$(volume_percent)
[[ $percent =~ ^[0-9]{1,9}$ ]] || exit 1
percent=$((10#$percent))
if volume_muted || ((${percent:-0} == 0)); then
  icon="volume-muted"
else
  icon="volume-high"
fi

flock -u "$volume_lock_fd"
omarchy-osd -i "$icon" -p "${percent:-0}" -x "$(maximum_percent)"
