#!/bin/bash

# omarchy:summary=Hide an application from the Omarchy launcher
# omarchy:args=<desktop-id> <name>
# omarchy:hidden=true

set -e
source "${OMARCHY_PATH:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)}/lib/omarchy-paths.sh"
desktop_id=${1:-}
desktop_id=${desktop_id%.desktop}
omarchy_require_flat_name "$desktop_id" "desktop ID" || exit 1
[[ $desktop_id != *[[:cntrl:]]* ]] || exit 1
hidden_file=$(omarchy_private_path "$OMARCHY_CONFIG_HOME" "$OMARCHY_CONFIG_HOME/launcher.hides") || exit 1
lock_file=$(omarchy_private_path "$OMARCHY_CONFIG_HOME" "$OMARCHY_CONFIG_HOME/launcher.hides.lock") || exit 1
mkdir -p -- "$OMARCHY_CONFIG_HOME"
exec 9>"$lock_file"
flock 9
{
  [[ ! -f $hidden_file ]] || cat "$hidden_file"
  printf '%s\n' "$desktop_id"
} | awk 'NF && !seen[$0]++' | omarchy_write_private_file "$OMARCHY_CONFIG_HOME" "$hidden_file"
