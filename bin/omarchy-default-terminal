#!/bin/bash

# omarchy:summary=Select the terminal used by Omarchy
# omarchy:args=[kitty]
# omarchy:examples=omarchy default terminal | omarchy default terminal kitty

source "${OMARCHY_PATH:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)}/lib/omarchy-paths.sh"
terminal_file="$OMARCHY_STATE_HOME/defaults/terminal"
if (( $# == 0 )); then
  if [[ -r $terminal_file ]]; then
    cat "$terminal_file"
  else
    echo kitty
  fi
  exit 0
fi
if [[ $1 != "kitty" ]] || omarchy-cmd-missing kitty; then
  echo "Omarchy supports the installed Kitty terminal." >&2
  exit 1
fi
printf '%s\n' kitty | omarchy_write_private_file "$OMARCHY_STATE_HOME" "$terminal_file" || exit 1
omarchy-notification-send "Kitty is now the Omarchy terminal"
