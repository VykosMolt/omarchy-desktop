#!/bin/bash

# omarchy:summary=Print running processes with live CPU and memory use as JSON
# omarchy:group=system
# omarchy:name=processes
# omarchy:args=[--limit <n>] [--interval <seconds>]
# omarchy:examples=omarchy system processes | omarchy system processes --limit 10

# `ps %cpu` averages over a process's whole lifetime, so a busy loop that
# started an hour ago and one that started a second ago read the same. A system
# monitor has to answer "what is using the CPU now", which is two samples of
# /proc/<pid>/stat and the difference between them -- the same thing top does.
#
# Output is one JSON array on stdout, already sorted by CPU descending, so the
# shell parses it once and renders it without deciding anything.

set -euo pipefail

limit=0
interval=0.5

usage() {
  echo "Usage: omarchy-system-processes [--limit <n>] [--interval <seconds>]"
}

while (( $# > 0 )); do
  case "$1" in
    --limit)
      (( $# >= 2 )) || { usage >&2; exit 1; }
      limit="$2"
      shift 2
      ;;
    --interval)
      (( $# >= 2 )) || { usage >&2; exit 1; }
      interval="$2"
      shift 2
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      usage >&2
      exit 1
      ;;
  esac
done

[[ $limit =~ ^[0-9]+$ ]] || { echo "omarchy-system-processes: --limit takes a whole number" >&2; exit 1; }
[[ $interval =~ ^[0-9]+([.][0-9]+)?$ ]] || { echo "omarchy-system-processes: --interval takes seconds" >&2; exit 1; }

# One Python process reads complete procfs records and emits JSON directly.
# Each row is tied to its kernel start time; a recycled PID cannot inherit the
# old process's CPU delta or become a different target in the system monitor.
exec python3 - "$limit" "$interval" <<'PYTHON'
import json
import os
import sys
import time

limit = int(sys.argv[1])
interval = float(sys.argv[2])
ticks = os.sysconf("SC_CLK_TCK")
page_kb = os.sysconf("SC_PAGE_SIZE") // 1024
cpu_count = os.cpu_count() or 1


def read_at(directory, name):
    fd = os.open(name, os.O_RDONLY, dir_fd=directory)
    with os.fdopen(fd, "rb") as source:
        return source.read().decode("utf-8", errors="replace")


def parse_stat(raw):
    closing = raw.rfind(")")
    opening = raw.find("(")
    if opening < 0 or closing <= opening:
        raise ValueError("invalid process stat")
    fields = raw[closing + 1:].split()
    return {
        "name": raw[opening + 1:closing],
        "ppid": int(fields[1]),
        "ticks": int(fields[11]) + int(fields[12]),
        "startTime": fields[19],
        "rssKb": max(0, int(fields[21])) * page_kb,
        "sampled": time.monotonic(),
    }


def sample():
    records = {}
    with os.scandir("/proc") as entries:
        for entry in entries:
            if not entry.name.isdecimal():
                continue
            try:
                with open(entry.path + "/stat", encoding="utf-8", errors="replace") as source:
                    records[int(entry.name)] = parse_stat(source.read())
            except (OSError, ValueError, IndexError):
                continue
    return records


first = sample()
if not first:
    sys.exit("omarchy-system-processes: could not read any process")
time.sleep(interval)
second = sample()
with open("/proc/meminfo") as source:
    mem_total = next(int(line.split()[1]) for line in source if line.startswith("MemTotal:"))

rows = []
for pid, current in second.items():
    before = first.get(pid)
    if before and before["startTime"] != current["startTime"]:
        continue
    elapsed = current["sampled"] - before["sampled"] if before else 0
    used = (current["ticks"] - before["ticks"]) / ticks if before else 0
    cpu = max(0, min(100 * cpu_count, used / elapsed * 100)) if elapsed > 0 else 0
    directory = None
    try:
        # An open proc directory keeps subsequent reads attached to this process
        # even if the PID is reused while its metadata is being collected.
        directory = os.open(f"/proc/{pid}", os.O_RDONLY | os.O_DIRECTORY)
        final = parse_stat(read_at(directory, "stat"))
        if final["startTime"] != current["startTime"]:
            continue
        try:
            command = read_at(directory, "cmdline").replace("\0", " ").rstrip()
        except OSError:
            command = ""
        uid = -1
        try:
            for line in read_at(directory, "status").splitlines():
                if line.startswith("Uid:"):
                    uid = int(line.split()[1])
                    break
        except OSError:
            pass
        unit, app_unit = "", False
        try:
            for line in read_at(directory, "cgroup").splitlines():
                if line.startswith("0::"):
                    group = line[3:]
                    app_unit = "/app.slice/" in group
                    unit = group.rsplit("/", 1)[-1]
                    break
        except OSError:
            pass
        if parse_stat(read_at(directory, "stat"))["startTime"] != current["startTime"]:
            continue
        rows.append({
            "pid": pid, "startTime": current["startTime"], "cpu": round(cpu, 4),
            "name": final["name"], "command": command or final["name"],
            "memory": round(final["rssKb"] / mem_total * 100, 4),
            "rssKb": final["rssKb"], "uid": uid, "ppid": final["ppid"],
            "unit": unit, "appUnit": app_unit,
        })
    except (OSError, ValueError, IndexError):
        continue
    finally:
        if directory is not None:
            os.close(directory)

rows.sort(key=lambda row: (-row["cpu"], row["pid"]))
print(json.dumps(rows[:limit] if limit else rows, ensure_ascii=True, separators=(",", ":")))
PYTHON
