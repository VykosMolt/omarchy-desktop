#!/bin/bash

# omarchy:summary=Create this session's own config, state, cache and data roots
# omarchy:hidden=true

set -euo pipefail

source "${OMARCHY_PATH:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)}/lib/omarchy-paths.sh"

marker="$OMARCHY_STATE_HOME/done/arch-session-bootstrap"

[[ -f $marker ]] && exit 0

mkdir -p \
  "$OMARCHY_CONFIG_HOME" \
  "$OMARCHY_STATE_HOME/done" \
  "$OMARCHY_CACHE_HOME" \
  "$OMARCHY_DATA_HOME"

# Only establish state owned by the independent Omarchy Arch session here.
# This port has no account-wide provisioning phase, by design.
touch "$marker"
