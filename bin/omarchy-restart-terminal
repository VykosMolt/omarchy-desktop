#!/bin/bash

# omarchy:summary=Reload this Omarchy session's Kitty windows after config changes

source "${OMARCHY_PATH:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)}/lib/omarchy-paths.sh"
source "${OMARCHY_PATH:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)}/lib/omarchy-process.sh"
kitty=$(omarchy_kitty_config) || exit 1
export KITTY_CONFIG_DIRECTORY=${kitty%/*}
omarchy_signal_session_processes kitty USR1
