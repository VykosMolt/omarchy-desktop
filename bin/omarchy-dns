#!/bin/bash

# omarchy:summary=Show or set the DNS servers NetworkManager uses on the connections that are up
# omarchy:args=[Cloudflare|Google|DHCP|Custom]
# omarchy:examples=omarchy dns | omarchy dns Cloudflare | omarchy dns DHCP

set -euo pipefail

# This sets DNS the way a desktop is allowed to: per NetworkManager connection,
# authorized by NetworkManager's own polkit action, the same thing GNOME's and
# Plasma's network panels do. It owns no file in /etc.
#
# The version this replaces owned two. It tee'd a whole-file
# /etc/systemd/resolved.conf, so a Domains=, DNSSEC=, Cache= or corporate search
# domain the user had put there was gone with no backup and no way back. It
# wrote /etc/NetworkManager/conf.d/20-omarchy-dns.conf to override DNS globally.
# And it rewrote ipv4.dns, ipv6.dns and both ignore-auto-dns flags on *every*
# saved wifi and ethernet profile -- fifteen of them on this machine -- so
# choosing a provider for the cafe rewrote the office and the phone hotspot too,
# and choosing DHCP erased a DNS server the user had set on any of them by hand.
# All of it was two clicks away in the network panel, behind a pkexec prompt.
#
# What a session may legitimately do is change the connections it is actually
# using. That is what this does.

CLOUDFLARE_V4="1.1.1.1 1.0.0.1"
CLOUDFLARE_V6="2606:4700:4700::1111 2606:4700:4700::1001"
GOOGLE_V4="8.8.8.8 8.8.4.4"
GOOGLE_V6="2001:4860:4860::8888 2001:4860:4860::8844"

provider_from_arg() {
  case "${1:-}" in
    Cloudflare | cloudflare) echo "Cloudflare" ;;
    Google | google) echo "Google" ;;
    DHCP | dhcp) echo "DHCP" ;;
    Custom | custom) echo "Custom" ;;
    *) return 1 ;;
  esac
}

# Only the connections carrying traffic right now. Bridges, tunnels and the
# fourteen profiles for networks we are not on are none of this command's
# business.
active_connections() {
  local uuid type

  while IFS=: read -r uuid type; do
    [[ -n $uuid ]] || continue
    case "$type" in
      802-11-wireless | 802-3-ethernet) printf '%s\n' "$uuid" ;;
    esac
  done < <(nmcli -t -f UUID,TYPE connection show --active)
}

# nmcli escapes ':' inside a value, which is every IPv6 address, so read the one
# field on its own rather than splitting a multi-field line.
connection_dns() {
  local uuid=$1 v4 v6

  v4=$(nmcli -g ipv4.dns connection show "$uuid" 2>/dev/null || true)
  v6=$(nmcli -g ipv6.dns connection show "$uuid" 2>/dev/null || true)
  printf '%s %s' "${v4//,/ }" "${v6//,/ }"
}

current_dns_provider() {
  local uuid dns=""

  while IFS= read -r uuid; do
    dns=$(connection_dns "$uuid")
    [[ -n $(printf '%s' "$dns" | tr -d '[:space:]') ]] && break
  done < <(active_connections)

  if [[ -z $(printf '%s' "$dns" | tr -d '[:space:]') ]]; then
    # No DNS pinned on the connection: it takes what the network offers.
    echo "DHCP"
  elif [[ " $dns " == *" 1.1.1.1 "* || " $dns " == *" 2606:4700:4700::1111 "* ]]; then
    echo "Cloudflare"
  elif [[ " $dns " == *" 8.8.8.8 "* || " $dns " == *" 2001:4860:4860::8888 "* ]]; then
    echo "Google"
  else
    echo "Custom"
  fi
}

split_dns_servers() {
  local server clean
  ipv4_dns=""
  ipv6_dns=""

  for server in $1; do
    clean=${server#dns+tls://}
    clean=${clean#dns+udp://}
    clean=${clean%%#*}
    clean=${clean#[}
    clean=${clean%]}

    [[ -n $clean ]] || continue
    if [[ $clean == *:* ]]; then
      ipv6_dns+="${ipv6_dns:+ }$clean"
    else
      ipv4_dns+="${ipv4_dns:+ }$clean"
    fi
  done
}

# Empty servers means "take what the network offers", which is ignore-auto-dns
# off and no pinned list -- the same thing GNOME's Automatic switch does.
apply_dns() {
  local v4=$1 v6=$2 uuid ignore=yes found=1

  [[ -n $v4$v6 ]] || ignore=no

  while IFS= read -r uuid; do
    found=0
    # NetworkManager's own polkit action authorizes this, so the prompt comes
    # from the session's agent and no sudoers rule or setuid path is involved.
    nmcli connection modify "$uuid" \
      ipv4.ignore-auto-dns "$ignore" ipv4.dns "$v4" \
      ipv6.ignore-auto-dns "$ignore" ipv6.dns "$v6"
  done < <(active_connections)

  if (( found != 0 )); then
    echo "No wifi or ethernet connection is up, so there is nothing to set DNS on." >&2
    return 1
  fi
}

reapply_active_devices() {
  local device type state

  while IFS=: read -r device type state; do
    [[ -n $device && $state == connected ]] || continue
    case "$type" in
      wifi | ethernet) nmcli device reapply "$device" >/dev/null 2>&1 || true ;;
    esac
  done < <(nmcli -t -f DEVICE,TYPE,STATE device status)
}

usage() {
  echo "Usage: omarchy-dns [Cloudflare|Google|DHCP|Custom]" >&2
}

if (( $# == 0 )); then
  current_dns_provider
  exit 0
fi

if (( $# > 1 )); then
  usage
  exit 1
fi

if ! provider=$(provider_from_arg "$1"); then
  usage
  exit 1
fi

case "$provider" in
  Cloudflare) apply_dns "$CLOUDFLARE_V4" "$CLOUDFLARE_V6" ;;
  Google) apply_dns "$GOOGLE_V4" "$GOOGLE_V6" ;;
  DHCP) apply_dns "" "" ;;
  Custom)
    echo "Enter your DNS servers (space-separated, e.g. '192.168.1.1 1.1.1.1'):"
    if ! read -r dns_servers; then
      dns_servers=""
    fi

    dns_servers=$(printf '%s\n' "$dns_servers" | tr ',\t' '  ' | xargs || true)
    if [[ -z $dns_servers ]]; then
      echo "Error: No DNS servers provided." >&2
      exit 1
    fi

    split_dns_servers "$dns_servers"
    apply_dns "$ipv4_dns" "$ipv6_dns"
    ;;
esac

reapply_active_devices
