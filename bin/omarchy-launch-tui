#!/bin/bash

# omarchy:summary=Launch a TUI command in the default terminal with Omarchy styling
# omarchy:args=[--app-id=<app-id>] <command> [args...]

if [[ ${1:-} == --app-id=* ]]; then
  APP_ID="${1#--app-id=}"
  shift
else
  APP_ID="org.omarchy.${1##*/}"
fi

(( $# > 0 )) && [[ -n $1 ]] || {
  echo "Usage: omarchy-launch-tui [--app-id=<app-id>] <command> [args...]" >&2
  exit 1
}
source "${OMARCHY_PATH:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)}/lib/omarchy-paths.sh"
kitty=$(omarchy_kitty_config) || exit 1
export KITTY_CONFIG_DIRECTORY=${kitty%/*}
exec setsid uwsm-app -- kitty --config "$kitty" --class "$APP_ID" "$@"
