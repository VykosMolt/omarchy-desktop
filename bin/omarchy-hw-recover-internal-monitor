#!/bin/bash

# omarchy:summary=Clear the internal-monitor-disable toggle if no external display is connected.

source "${OMARCHY_PATH:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)}/lib/omarchy-paths.sh"

TOGGLE="$OMARCHY_STATE_HOME/toggles/hypr/internal-monitor-disable.lua"

if [[ -f $TOGGLE ]] && ! omarchy-hw-external-monitors; then
  rm -f "$TOGGLE"
fi
