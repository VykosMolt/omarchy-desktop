#!/bin/bash

# omarchy:summary=Select and set the system timezone
# omarchy:group=menu
# omarchy:name=timezone

set -e

timezone=$(timedatectl list-timezones | omarchy-menu-select "Set timezone" -- --width 520 --maxheight 520) || exit 1
# systemd-timedated carries its own polkit policy, so this prompts on its own
# in a desktop session. Do not put sudo in front of it: that would need a
# passwordless sudoers rule this port deliberately does not install.
timedatectl set-timezone "$timezone"
omarchy-shell -q omarchy.clock refresh
omarchy-notification-send "Timezone is now set to $timezone"
