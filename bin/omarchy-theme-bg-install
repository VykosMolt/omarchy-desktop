#!/bin/bash

# omarchy:summary=Open the current theme's user background folder

source "${OMARCHY_PATH:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)}/lib/omarchy-paths.sh"

CURRENT_THEME_NAME=$(cat "$OMARCHY_STATE_HOME/current/theme.name")
THEME_USER_BACKGROUNDS="$OMARCHY_CONFIG_HOME/backgrounds/$CURRENT_THEME_NAME"

mkdir -p "$THEME_USER_BACKGROUNDS"
nautilus "$THEME_USER_BACKGROUNDS"
