#!/bin/bash
source "${OMARCHY_PATH:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)}/lib/omarchy-paths.sh"

# omarchy:summary=Reset shell.json to Omarchy defaults
# omarchy:examples=omarchy refresh shell

set -euo pipefail

OMARCHY_REFRESH_CONFIG_HOME="$OMARCHY_SESSION_CONFIG_HOME" omarchy-refresh-config omarchy/shell.json
omarchy-bar defaults

omarchy-restart-shell
