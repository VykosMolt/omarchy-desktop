#!/bin/bash

# omarchy:summary=Cache background switcher thumbnails for the current theme

source "${OMARCHY_PATH:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)}/lib/omarchy-paths.sh"
source "${OMARCHY_PATH:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)}/lib/omarchy-backgrounds.sh"

# The same directory list the switcher opens with, so the rows this warms are
# the rows it reads back: omarchy-menu-images keys its cache on that list.
mapfile -t image_dirs < <(omarchy_background_dirs)

omarchy-menu-images \
  --cache-only \
  "${image_dirs[@]}"
