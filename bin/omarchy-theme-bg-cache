#!/bin/bash

# omarchy:summary=Cache background switcher thumbnails for the current theme

source "${OMARCHY_PATH:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)}/lib/omarchy-paths.sh"

theme_name=$(cat "$OMARCHY_STATE_HOME/current/theme.name" 2>/dev/null)

omarchy-menu-images \
  --cache-only \
  "$OMARCHY_STATE_HOME/current/theme/backgrounds" \
  "$OMARCHY_CONFIG_HOME/backgrounds/$theme_name"
