#!/bin/bash

# omarchy:summary=Copy text to the clipboard and type or paste it
# omarchy:group=clipboard
# omarchy:args=[--shift-insert] [--copy-only] [--history-index <index>|<text>]
# omarchy:examples=omarchy clipboard paste text "hello" | omarchy clipboard paste text --shift-insert "hello"
# omarchy:hidden=true

source "${OMARCHY_PATH:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)}/lib/omarchy-paths.sh"

set -o pipefail

use_shift_insert=false
copy_only=false
history_index=""
text=""

while (( $# > 0 )); do
  case "$1" in
    --shift-insert)
      use_shift_insert=true
      shift
      ;;
    --copy-only)
      copy_only=true
      shift
      ;;
    --history-index)
      (( $# >= 2 )) || { echo "--history-index requires an index" >&2; exit 1; }
      history_index="${2:-}"
      [[ $history_index =~ ^[0-9]+$ ]] || exit 1
      shift 2
      ;;
    --)
      shift
      break
      ;;
    *)
      break
      ;;
  esac
done

copy_history_entry() {
  local history_path="$OMARCHY_STATE_HOME/clipboard-history.json"

  [[ $history_index =~ ^[0-9]+$ ]] || exit
  jq -ej --argjson index "$history_index" ' .[$index] | select(.type == "text" and (.text | type == "string")) | .text' "$history_path" | wl-copy
}

if [[ -n $history_index ]]; then
  copy_history_entry || exit 1
  if [[ $copy_only != "true" ]]; then
    use_shift_insert=true
  fi
else
  text=${1:-}
  [[ -n $text ]] || exit
  printf '%s' "$text" | wl-copy || exit 1
fi

if [[ $copy_only == "true" ]]; then
  exit
fi

sleep 0.15

if [[ $use_shift_insert == "true" ]]; then
  wtype -M shift -k Insert -m shift 2>/dev/null || true
else
  wtype -- "$text" 2>/dev/null || true
fi
